# FRAUD SHIELD Backend Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Model & Scaler Artifact Paths (relative to backend or absolute)
MODEL_PATH=../ML/model.pkl
SCALER_PATH=../ML/scaler.pkl
METRICS_PATH=app/metrics.json
FRONTEND_HTML_PATH=../frontend/index.html

# Classification Decision Threshold (from notebooks: 0.50, UI visualizer: 0.55)
DECISION_THRESHOLD=0.50

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# CORS Allowed Origins
CORS_ORIGINS=["*"]
